{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-information-system",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Student IMS",
    "APP_VERSION": "1.4.9"
  }
}
