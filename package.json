{
  "name": "student-ims-next",
  "version": "1.4.6",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && npm test",
    "dev": "wrangler dev",
    "deploy": "node scripts/predeploy.mjs && wrangler deploy --name student-information-system",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/predeploy.mjs && wrangler d1 migrations apply DB --remote",
    "deploy:check": "node scripts/predeploy.mjs",
    "configure:production": "node scripts/configure-production.mjs"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=20"
  }
}
